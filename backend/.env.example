DATABASE_URL=postgres://postgres:password@localhost:5432/inheritx

# Log output format: json (default) | pretty | compact
# Use "pretty" or "compact" during local development for human-readable output.
# Leave as "json" (or unset) in staging/production for log aggregator compatibility.
LOG_FORMAT=json

DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT=30
DB_IDLE_TIMEOUT=600

# Hard cap (ms) on how long any single query may run before Postgres cancels##it. Applies to every pooled connection (web requests and background jobs
# such as the inactivity watchdog), preventing a stuck query from holding
# locks and exhausting the pool.
DB_STATEMENT_TIMEOUT_MS=10000
# Log a warning when a query's execution time exceeds this threshold (ms).
DB_SLOW_QUERY_WARN_MS=500

INACTIVITY_WATCHDOG_INTERVAL_SECS=3600
INACTIVITY_WATCHDOG_BATCH_SIZE=500

# Distinct guardian signatures required before the backend submits
# guardian_emergency_trigger to Soroban. Defaults to 2, capped at 5.
GUARDIAN_UNLOCK_THRESHOLD=2
# Optional comma-separated allowlist of guardian G... addresses. When empty,
# the inheritance contract remains the source of truth for membership.
GUARDIAN_UNLOCK_GUARDIANS=

# Shared secret used to verify HMAC-SHA256 signatures on inbound KYC provider
# webhooks (X-KYC-Signature header). Required: without it /api/kyc/webhook
# rejects every request with 503.
KYC_WEBHOOK_SECRET=

# Base URL for the Stellar Anchor API (SEP-31). Used for triggering fiat payouts.
# Defaults to http://localhost:8081 if not set.
ANCHOR_API_URL=http://localhost:8081

# TTL (seconds) for the cached GET /api/analytics/plan-statistics response.
# Defaults to 60. Uses REDIS_URL when set, otherwise an in-process fallback.
PLAN_STATISTICS_CACHE_TTL_SECS=60

# Comma-separated ISO 3166-1 alpha-2 country codes to block at the API edge
# (sanctions-region guard). Defaults to the OFAC comprehensively-sanctioned
# jurisdictions (CU, I, KP, SY) when unset.
OFAC_BLOCKED_COUNTRIES=CU,IR,KP,SY

# Path to a local MaxMind GeoIP2/GeoLite2 Country .mmdb file. Only used when
# the backend is built with `--features geoip`, and only consulted when the
# request has no `CF-IPCountry` Header (i.e. not behind Cloudflare). Leave
# unset to rely on the CF-IPCountry header alone.
GEOIP_DB_PATH=

# --- Beneficiary email verification ---
# Smtp delivery for beneficiary verification emails. When SMTP_HOST is set
# the backend sends via SMTP; when SENDGRID_API_KEY is set it sends via
# SendGrid. If neither is configured the verification endpoint returns
# 503 so the failure is explicit rather than silently dropping the email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EM=no-reply@localhost
SMTP_USE_TLS=true

# SendGrid API key. Takes precedence over SMTP when both are configured.
SENDGRID_API_KEY=
SENDGRID_FROM_EMail=no-reply@localhost

# Public base URL of this backend, used to build the verification link
# embedded in beneficiary emails (e.g. http://localhost:8080).
APP_BASE_URL=http://localhost:8080

# How long (hours) a beneficiary verification token remains valid.
BENEFICIARY_VERIFY_TOKEN_TTL_HOURS=48
